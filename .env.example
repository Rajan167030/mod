# Application
APP_NAME="Secure AirOps Scheduler"
APP_ENV=development
DEBUG=True
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Requests without a token act as demo ADMIN (bypasses RBAC). Keep False.
AUTH_DEV_BYPASS=False

# Database
# For development/demo with SQLite fallback or PostgreSQL:
DATABASE_URL=sqlite:///./test.db
# PostgreSQL Example:
# DATABASE_URL=postgresql+psycopg2://scheduler:scheduler_pass@localhost:5432/scheduler_db

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Solver Settings
SOLVER_MAX_TIME_SECONDS=30
SOLVER_NUM_WORKERS=4
SOLVER_RANDOM_SEED=42

# Weather Provider Settings
WEATHER_PROVIDER_BASE_URL=https://api.open-meteo.com/v1
WEATHER_CACHE_TTL_SECONDS=900
WEATHER_REQUEST_TIMEOUT_SECONDS=10
WEATHER_STALE_MULTIPLIER=2
# Fetch all sites in the background at startup so the first page load is fast
WEATHER_PREFETCH_ON_STARTUP=True

# Weather Demonstration Thresholds (illustrative, not operational)
WEATHER_WIND_WARNING_KMH=45
WEATHER_WIND_CRITICAL_KMH=65
WEATHER_PRECIP_WARNING_MM=5
WEATHER_PRECIP_CRITICAL_MM=15
WEATHER_TEMP_LOW_WARNING_C=-10
WEATHER_TEMP_LOW_CRITICAL_C=-25


# Planning copilot (optional). Without a key the rest of the app works; the copilot shows a setup note.
# COPILOT_PROVIDER: "groq" (current) or "anthropic"
COPILOT_PROVIDER=groq
GROQ_API_KEY=
COPILOT_GROQ_MODEL=openai/gpt-oss-120b
# Used when COPILOT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-opus-5-5
COPILOT_EFFORT=medium
